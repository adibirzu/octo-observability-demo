{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Octo control-plane pipeline manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repository",
    "componentIds",
    "domainVariable",
    "routes",
    "containerBuilds",
    "smoke",
    "ormPackageScripts",
    "sbom"
  ],
  "properties": {
    "$schema": {
      "const": "./cp-pipeline-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "componentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c[1-9][0-9]*$"
      }
    },
    "domainVariable": {
      "const": "DNS_DOMAIN"
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cp",
        "shop",
        "crm",
        "ai"
      ],
      "properties": {
        "cp": {
          "const": "https://cp.<DNS_DOMAIN>"
        },
        "shop": {
          "const": "https://shop.<DNS_DOMAIN>"
        },
        "crm": {
          "const": "https://crm.<DNS_DOMAIN>"
        },
        "ai": {
          "const": "https://ai.<DNS_DOMAIN>"
        }
      }
    },
    "containerBuilds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dockerfile",
          "context",
          "image",
          "stages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "dockerfile": {
            "type": "string",
            "pattern": "^(shop|crm|services|tools)/(?:[A-Za-z0-9_-]+/)*Dockerfile(?:\\.[A-Za-z0-9_-]+)?$"
          },
          "context": {
            "type": "string",
            "pattern": "^(?:\\.|(?:shop|crm|services|tools)(?:/[A-Za-z0-9_-]+)*)$"
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "meltS",
        "sso"
      ],
      "properties": {
        "health": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/smokeCheck"
          }
        },
        "meltS": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/smokeCheck"
          }
        },
        "sso": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/smokeCheck"
          }
        }
      }
    },
    "ormPackageScripts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:shop/)?deploy/(?:resource-manager|compute)/stack-package\\.sh$"
      }
    },
    "sbom": {
      "const": "sbom/octo-observability-demo.cdx.json"
    }
  },
  "$defs": {
    "smokeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "path"
      ],
      "properties": {
        "route": {
          "enum": [
            "cp",
            "shop",
            "crm",
            "ai"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
