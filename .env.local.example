# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — copy to .env.local and fill REAL values (local only).
#
#   cp .env.local.example .env.local   # .env.local is gitignored; never commit it
#
# .env.local holds the per-developer / per-tenancy values the deploy + apply
# scripts read. Nothing here is committed except this placeholder file. Real
# OCIDs, keys, DSNs, profile names, and IPs live ONLY in your local .env.local
# and in OCI secrets — never in tracked source.
#
# Load it before running scripts:   set -a; . ./.env.local; set +a
# ─────────────────────────────────────────────────────────────────────────────

# ── OCI CLI profile + region (local ~/.oci/config profile name) ──────────────
# The profile name is environment-specific; keep it out of tracked code.
OCI_PROFILE=DEFAULT
OCI_CLI_PROFILE=DEFAULT
OCI_REGION=<REGION>                      # e.g. us-phoenix-1 / eu-frankfurt-1
OCIR_REGION=<OCIR_REGION>                # registry region
OCIR_TENANCY=<OCIR_TENANCY_NAMESPACE>    # object-storage namespace for OCIR

# ── Core compartment / domains (OCIDs — local only) ──────────────────────────
COMPARTMENT_ID=<COMPARTMENT_OCID>
APM_DOMAIN_ID=<APM_DOMAIN_OCID>
NOTIFICATION_TOPIC_OCID=<NOTIFICATIONS_TOPIC_OCID>
AUTONOMOUS_DATABASE_ID=<ATP_OCID>

# ── OKE target (always the existing cluster in demo) ───────────────────────
OKE_CLUSTER_NAME=octo-apm-demo-oke       # NEVER create additional OKE clusters

# ── Deployment outputs file (per-profile, gitignored credentials dir) ────────
# Scripts default to ${REPO_ROOT}/credentials/${OCI_PROFILE}/outputs.json
OUTPUTS_FILE=
OUTPUTS_JSON=

# ── App / GenAI Studio runtime (mirror of OCI secrets; for local runs only) ──
AI_STUDIO_ENABLED=false
AI_STUDIO_BASE_URL=http://genai-studio:8090
AI_STUDIO_INTERNAL_SERVICE_KEY=<INTERNAL_SERVICE_KEY>
OCI_GENAI_MODEL_ID=<GENAI_CHAT_MODEL_ID>
OCI_GENAI_EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
OCI_GENAI_ENDPOINT=https://inference.generativeai.<REGION>.oci.oraclecloud.com
OCI_GENAI_COMPARTMENT_ID=<COMPARTMENT_OCID>
STUDIO_RAG_ENABLED=true
STUDIO_EMBED_DIM=1024
STUDIO_RAG_TOP_K=4
STUDIO_RAG_KB_TABLE=genai_kb

# ── Read-only ATP (Sales Analyst / Data Q&A / RAG agent) ─────────────────────
STUDIO_DB_KIND=oracle
STUDIO_DB_DSN=<ATP_READONLY_DSN>
STUDIO_DB_USER=<ATP_READONLY_USER>
STUDIO_DB_PASSWORD=<ATP_READONLY_PASSWORD>
STUDIO_ORACLE_WALLET_DIR=/app/wallet
STUDIO_ORACLE_WALLET_PASSWORD=<ATP_WALLET_PASSWORD>

# ── ATP ADMIN (seeding genai_kb only — never the agent) ──────────────────────
SEED_DB_USER=<ATP_ADMIN_USER>
SEED_DB_PASSWORD=<ATP_ADMIN_PASSWORD>
SEED_DB_DSN=<ATP_DSN>

# ── Observability backends ───────────────────────────────────────────────────
OCI_APM_ENDPOINT=<APM_UPLOAD_ENDPOINT>
OCI_APM_PRIVATE_DATA_KEY=<APM_PRIVATE_DATAKEY>
LANGFUSE_BASE_URL=https://lf.<DNS_DOMAIN>
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
OCI_MONITORING_COMPARTMENT_ID=<COMPARTMENT_OCID>

# ── Admin GenAI Observability deep links (optional; env-driven) ──────────────
APM_CONSOLE_URL=
LANGFUSE_DASHBOARD_URL=
GENAI_GRAFANA_URL=
GENAI_COMMAND_CENTER_URL=

# ── Public demo domain (safe to commit elsewhere) ────────────────────────────
DNS_DOMAIN=octodemo.cloud
