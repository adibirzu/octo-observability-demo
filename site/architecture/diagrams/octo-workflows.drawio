<mxfile host="app.diagrams.net" type="device">
  <diagram id="octo-workflows" name="OCTO Workflows">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="layer-notes" value="Notes and flows" parent="0" />
        <mxCell id="layer-app" value="Application runtime" parent="0" />
        <mxCell id="layer-data" value="Data plane" parent="0" />
        <mxCell id="layer-obs" value="Observability services" parent="0" />
        <mxCell id="layer-legend" value="Correlation legend" parent="0" />

        <mxCell id="title" value="OCTO Demo - four workflows and the observability fan-out" style="text;html=1;align=left;fontSize=16;fontStyle=1;" parent="layer-notes" vertex="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="band-app" value="Workflows 1-3 - request path (solid)" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#6B7280;" parent="layer-notes" vertex="1">
          <mxGeometry x="40" y="70" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band-obs" value="Workflow 4 - observability fan-out (dashed = async export)" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#6B7280;" parent="layer-notes" vertex="1">
          <mxGeometry x="40" y="430" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="app-shop" value="Storefront browse + checkout&#10;octo-drone-shop (FastAPI)&#10;RUM in browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="layer-app" vertex="1">
          <mxGeometry x="40" y="100" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app-java" value="Payment&#10;octo-apm-java-demo&#10;APM Java agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="layer-app" vertex="1">
          <mxGeometry x="320" y="100" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app-crm" value="CRM order sync&#10;enterprise-crm-portal (FastAPI)&#10;invoice PDF -&gt; ATP BLOB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="layer-app" vertex="1">
          <mxGeometry x="570" y="100" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app-studio" value="AI Studio&#10;octo-genai-studio&#10;ask / rag / brief / chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" parent="layer-app" vertex="1">
          <mxGeometry x="870" y="100" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="db-atp" value="Autonomous DB OCTOATP (Oracle 19c)&#10;orders, customers, invoices (SecureFile BLOB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FB923C;strokeColor=#9A3412;" parent="layer-data" vertex="1">
          <mxGeometry x="430" y="270" width="380" height="70" as="geometry" />
        </mxCell>

        <mxCell id="obs-apm" value="OCI APM (main domain)&#10;traces + topology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="40" y="470" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-aiapm" value="octo-ai-apm domain&#10;gen_ai.* numerics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="260" y="470" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-rum" value="OCI RUM&#10;browser sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="470" y="470" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-langfuse" value="Langfuse&#10;multi-agent trace tree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="660" y="470" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="obs-logan" value="OCI Logging Analytics&#10;logs joined on oracleApmTraceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="40" y="560" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-mon" value="OCI Monitoring&#10;octo_genai namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="290" y="560" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-opsi" value="OPS Insights&#10;OCTOATP SQL trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="510" y="560" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="obs-dbm" value="Database Management&#10;OCTOATP health + sql_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;" parent="layer-obs" vertex="1">
          <mxGeometry x="710" y="560" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-shop-java" value="payment" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-shop" target="app-java" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-java-crm" value="order sync (traceparent)" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-java" target="app-crm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-crm-studio" value="SSO admin host" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-crm" target="app-studio" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-shop-db" value="SQL" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-shop" target="db-atp" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-crm-db" value="SQL + BLOB" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-crm" target="db-atp" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-studio-db" value="read-only (studio_ro)" style="endArrow=block;html=1;strokeColor=#374151;" parent="layer-notes" source="app-studio" target="db-atp" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-shop-rum" value="browser" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-shop" target="obs-rum" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-shop-apm" value="traces" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-shop" target="obs-apm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-java-apm" value="App Server" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-java" target="obs-apm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-studio-aiapm" value="gen_ai.*" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-studio" target="obs-aiapm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-studio-lf" value="run_id = trace id" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-studio" target="obs-langfuse" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-crm-logan" value="logs (oracleApmTraceId)" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="app-crm" target="obs-logan" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lf-mon" value="hourly sync" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="obs-langfuse" target="obs-mon" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-opsi" value="SQL perf" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="db-atp" target="obs-opsi" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-dbm" value="db health" style="endArrow=open;dashed=1;html=1;strokeColor=#059669;" parent="layer-notes" source="db-atp" target="obs-dbm" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend&#10;Yellow - application services    Orange - data plane (ATP)    Green - OCI observability&#10;Solid arrow - synchronous request path    Dashed arrow - async / telemetry export&#10;One oracleApmTraceId joins every hop; studio.run_id joins AI Studio across APM and Langfuse.&#10;Public diagram - DNS uses placeholder hosts only; no OCIDs, IPs, datakeys, or tenancy names." style="text;html=1;align=left;whiteSpace=wrap;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontSize=11;" parent="layer-legend" vertex="1">
          <mxGeometry x="40" y="660" width="880" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
