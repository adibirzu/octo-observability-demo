# OCTO Drone Shop — AI Studio (GenAI multi-agent) service
# Copy to .env and fill real values from your tenancy / Vault.
# NEVER commit real OCIDs, datakeys, IPs, or Langfuse keys — use placeholders here.

# ── Service ───────────────────────────────────────────────────────────────
STUDIO_PORT=8090
STUDIO_INTERNAL_SERVICE_KEY=<INTERNAL_SERVICE_KEY>   # shared secret the shop proxy presents
STUDIO_MAX_STEPS=8                                   # supervisor recursion cap
STUDIO_MESSAGE_MAX_CHARS=1000

# ── OCI Generative AI (langchain-oci ChatOCIGenAI) ─────────────────────────
OCI_GENAI_MODEL_ID=<OCI_GENAI_MODEL_ID>              # e.g. cohere.command-r-08-2024 / meta.llama-3.3-70b-instruct
OCI_GENAI_COMPARTMENT_ID=<LOGANALYTICS_COMPARTMENT_OCID>
OCI_GENAI_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
OCI_AUTH_TYPE=INSTANCE_PRINCIPAL                     # API_KEY | INSTANCE_PRINCIPAL | RESOURCE_PRINCIPAL
OCI_CONFIG_PROFILE=DEFAULT                           # only used when OCI_AUTH_TYPE=API_KEY
GENAI_TEMPERATURE=0.2
GENAI_MAX_TOKENS=800

# ── Observability: OTEL -> OCI APM ─────────────────────────────────────────
OTEL_SERVICE_NAME=octo-genai-studio
# service.namespace must be 'octo' fleet-wide for consistent APM topology grouping
# (the pod still runs in the k8s namespace octo-drone-shop — these are different).
SERVICE_NAMESPACE=octo
APP_VERSION=0.1.0
OCI_APM_ENDPOINT=<OCI_APM_ENDPOINT>                  # https://<id>.apm-agt.<region>.oci.oraclecloud.com
OCI_APM_PRIVATE_DATA_KEY=<APM_PRIVATE_DATAKEY>

# ── Observability: Langfuse (self-hosted) ──────────────────────────────────
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_BASE_URL=https://lf.<DNS_DOMAIN>
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_SAMPLE_RATE=1.0

# ── Read-only data access (Sales Analyst agent) ────────────────────────────
# Oracle ATP read-only user, OR a Postgres DSN for the local stack.
STUDIO_DB_KIND=oracle                                # oracle | postgres | none
STUDIO_DB_DSN=<ATP_READONLY_DSN>
STUDIO_DB_USER=<ATP_READONLY_USER>
STUDIO_DB_PASSWORD=<ATP_READONLY_PASSWORD>
STUDIO_ORACLE_WALLET_DIR=/app/wallet
STUDIO_ORACLE_WALLET_PASSWORD=<ATP_WALLET_PASSWORD>
# Postgres fallback for docker-compose local stack:
# STUDIO_DB_KIND=postgres
# STUDIO_DB_DSN=postgresql://octo:octo@db:5432/octo

# ── RAG (Oracle 23ai native VECTOR; optional, off by default) ──────────────
# Requires STUDIO_DB_KIND=oracle on a 23ai DB + genai_kb seeded (db/migrations).
STUDIO_RAG_ENABLED=false
# Embedding model; dimension MUST match the genai_kb.embedding VECTOR(N) column.
OCI_GENAI_EMBED_MODEL_ID=cohere.embed-multilingual-v3.0
STUDIO_EMBED_DIM=1024
STUDIO_RAG_TOP_K=4
STUDIO_RAG_KB_TABLE=genai_kb
# Seeding only (writeable user; NEVER studio_ro). Used by scripts/seed_genai_kb.py.
SEED_DB_USER=<ATP_WRITER_USER>
SEED_DB_PASSWORD=<ATP_WRITER_PASSWORD>
SEED_DB_DSN=<ATP_DSN>

# ── Evidence agent ─────────────────────────────────────────────────────────
STUDIO_WEB_SEARCH_ENABLED=false
