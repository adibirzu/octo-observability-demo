# OCTO-DEMO — GenAI Observability Stack (Langfuse + Grafana on OKE)
# Copy to .env and fill from your tenancy. Placeholders only here — never commit
# real OCIDs, IPs, tenancy names, datakeys, admin passwords, or Langfuse keys.

# ── Target tenancy / cluster (resolved from credentials/<profile>/outputs.json
#    by the deploy scripts when left blank) ─────────────────────────────────
OCI_PROFILE=<OCI_PROFILE>                    # your OCI CLI profile name
OCI_REGION=<OCI_REGION>                      # e.g. us-phoenix-1 / eu-frankfurt-1
COMPARTMENT_ID=<COMPARTMENT_OCID>
TARGET_VCN_ID=<VCN_OCID>
OCI_LB_SUBNET_OCID=<LB_SUBNET_OCID>
# Refuse to deploy outside the OCTO project VCN unless explicitly overridden.
ALLOW_DIFFERENT_VCN=false

# ── DNS (the *.<DNS_DOMAIN> demo domain is the accepted public placeholder) ─
LANGFUSE_HOSTNAME=langfuse.<DNS_DOMAIN>
LANGFUSE_PUBLIC_URL=https://langfuse.<DNS_DOMAIN>
GRAFANA_HOSTNAME=grafana.<DNS_DOMAIN>
GRAFANA_PUBLIC_URL=https://grafana.<DNS_DOMAIN>

# ── Langfuse (OKE) — secrets are GENERATED at deploy time when unset ─────────
LANGFUSE_NAMESPACE=octo-langfuse
LANGFUSE_STORAGE_CLASS=oci-bv
# Optional: wire the shop's octo-llmetry secret to a Langfuse project after
# creating it in the UI (DO NOT commit these — set at deploy time only):
# APP_LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
# APP_LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
# LANGFUSE_PROJECT_NAME=drones.<DNS_DOMAIN>

# ── Grafana (OKE) — admin password + API token GENERATED at deploy time ─────
GRAFANA_NAMESPACE=octo-grafana
GRAFANA_STORAGE_CLASS=oci-bv
GRAFANA_STORAGE=5Gi
# GenAI JSON/metrics API the Infinity datasource queries (in-cluster AI Studio).
GENAI_API_BASE=http://octo-genai-studio.octo-drone-shop.svc.cluster.local:8090
# GENAI_API_TOKEN=<INTERNAL_SERVICE_KEY>     # optional; generated if unset

# ── Load balancer sizing ────────────────────────────────────────────────────
OCI_LB_SHAPE_FLEX_MIN=10
OCI_LB_SHAPE_FLEX_MAX=10
